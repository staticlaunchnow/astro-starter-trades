---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": site.schemaType,
  name: site.brand,
  telephone: site.phoneHref,
  email: site.email,
  areaServed: site.area,
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <div class="wrap nav">
      <a class="brand" href="/">{site.brand}</a>
      <nav class="nav-links" aria-label="Main">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
        <a href={`/${site.secondarySlug}/`} aria-current={path.startsWith(`/${site.secondarySlug}`) ? "page" : undefined}>{site.secondaryLabel}</a>
        <a href="/about/" aria-current={path.startsWith("/about") ? "page" : undefined}>About</a>
        <a href="/contact/" aria-current={path.startsWith("/contact") ? "page" : undefined}>Contact</a>
        <a class="btn" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer>
    <div class="wrap">
      <p>© 2026 {site.brand} · {site.area} · {site.hours}</p>
      <p>Independently owned static Astro site — starter built with <a href="https://staticlaunch.com/templates/">StaticLaunch</a>.</p>
    </div>
  </footer>
</body>
</html>
